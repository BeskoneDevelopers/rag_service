POSTGRES_USER=rag
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=rag

DATABASE_URL=postgresql+asyncpg://rag:local-development-password@db:5432/rag
DATABASE_SYNC_URL=postgresql+psycopg://rag:local-development-password@db:5432/rag
DEBUG=false

# Generate a private value before starting: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-this-local-development-secret-before-use

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=600
CELERY_VISIBILITY_TIMEOUT=900
LLM_CHAT_URL=http://host.docker.internal:8081/v1/chat/completions
LLM_MODEL=qwen3.5-2b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_GENERATION_TIMEOUT_SECONDS=60
EMBEDDINGS_URL=http://host.docker.internal:8082/v1/embeddings
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BATCH_SIZE=8
EMBEDDINGS_TIMEOUT_SECONDS=180
